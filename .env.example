# ==========================================
# FREE CASH — PRODUCTION ENVIRONMENT TEMPLATE
# ==========================================

# 1. DATABASE CONFIGURATION (PostgreSQL)
DATABASE_URL="postgresql://postgres:your_secure_password@localhost:5432/freecash?schema=public&sslmode=prefer"

# 2. AUTHENTICATION & JWT SECURITY
JWT_SECRET="production_super_secret_jwt_key_at_least_32_characters_long_12345"
AUTH_COOKIE_NAME="freecash_session"

# 3. PAYMENT GATEWAY INTEGRATION (Paystack / Flutterwave)
PAYSTACK_SECRET_KEY="sk_live_xxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_live_xxxxxxxxx"
WEBHOOK_SECRET="whsec_xxxxxxxx"

# 4. APPLICATION CANONICAL DOMAIN
NEXT_PUBLIC_APP_URL="https://freecash.com"

# 5. ENVIRONMENT MODE
NODE_ENV="production"
